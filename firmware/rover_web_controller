/**
 * Maps normalized motor output (-1.0 to +1.0) into PWM with deadband compensation.
 * Overcomes static gearbox stiction and L298N Vce saturation drop (~2V).
 */
int applyDeadband(float normalizedVal, int maxPwm) {
  if (fabs(normalizedVal) < 0.05f) return 0; // Deadzone threshold

  int minPwm = MOTOR_MIN_PWM;
  if (minPwm > maxPwm) minPwm = maxPwm;

  // Linear scaling between MIN_PWM and max available PWM
  int magnitude = minPwm + (int)(fabs(normalizedVal) * (maxPwm - minPwm));
  magnitude = constrain(magnitude, 0, 255);

  return (normalizedVal > 0) ? magnitude : -magnitude;
}

/**
 * Differential-Drive Skid-Steer Kinematics with Priority Normalization.
 * Seamlessly mixes forward/reverse velocity with steering yaw rate.
 */
void computeDifferentialKinematics(float throttleCmd, float steerCmd, int maxPwm, int &outLeftPwm, int &outRightPwm) {
  // Skid-steer mixing equations:
  // Turning Right (steer > 0) -> Left tracks speed up, Right tracks slow down/reverse
  float rawLeft  = throttleCmd + steerCmd;
  float rawRight = throttleCmd - steerCmd;

  // Normalization: preserves steering curvature if inputs exceed +/- 1.0 limit
  float maxMag = max(fabs(rawLeft), fabs(rawRight));
  if (maxMag > 1.0f) {
    rawLeft  /= maxMag;
    rawRight /= maxMag;
  }

  outLeftPwm  = applyDeadband(rawLeft, maxPwm);
  outRightPwm = applyDeadband(rawRight, maxPwm);
}

/**
 * Asymmetric Slew-Rate Limiter (Soft-Start Acceleration Filter)
 * Mitigates in-rush current draw that causes ESP32 brownout resets during direction changes.
 */
void applySlewLimiter(int &currentSpeed, int targetSpeed) {
  if (currentSpeed < targetSpeed) {
    // Accelerating forward or decelerating reverse
    int step = (currentSpeed >= 0) ? RAMP_ACCEL_STEP : RAMP_DECEL_STEP;
    currentSpeed = min(currentSpeed + step, targetSpeed);
  } else if (currentSpeed > targetSpeed) {
    // Decelerating forward or accelerating reverse
    int step = (currentSpeed <= 0) ? RAMP_ACCEL_STEP : RAMP_DECEL_STEP;
    currentSpeed = max(currentSpeed - step, targetSpeed);
  }
}

/**
 * Direct H-Bridge Channel Output: Sets PWM duty cycle to dual LEDC pins per motor.
 */
void writeBridgeChannel(int fwdCh, int revCh, int duty) {
  if (duty > 0) {
    ledcWrite(fwdCh, duty);
    ledcWrite(revCh, 0);
  } else if (duty < 0) {
    ledcWrite(fwdCh, 0);
    ledcWrite(revCh, abs(duty));
  } else {
    // Coasting: both switches open (high impedance, zero current draw)
    ledcWrite(fwdCh, 0);
    ledcWrite(revCh, 0);
  }
}

/**
 * Dynamic Regenerative Braking: Clamps both motor terminals HIGH.
 * Generates reverse electromagnetic torque opposing motor armature momentum.
 */
void executeDynamicBrake() {
  const int channels[8] = {
    CH_FL_FWD, CH_FL_REV, CH_FR_FWD, CH_FR_REV, 
    CH_RL_FWD, CH_RL_REV, CH_RR_FWD, CH_RR_REV
  };
  for (int i = 0; i < 8; i++) {
    ledcWrite(channels[i], 255);
  }
}

/**
 * Primary Motor Pipeline: Evaluates vehicle state, runs kinematics, and writes to hardware.
 */
void updateMotorController() {
  // 1. Evaluate State Transitions
  if (parkingBrake == 1 || inputBrake > 10) {
    currentState = STATE_BRAKE;
  } else if (inputThrottle == 0 && abs(inputSteer) < 5) {
    currentState = STATE_COAST;
  } else {
    currentState = STATE_DRIVE;
  }

  // 2. Execute State Logic
  switch (currentState) {
    case STATE_BRAKE:
      targetFL = targetFR = targetRL = targetRR = 0;
      currentFL = currentFR = currentRL = currentRR = 0;
      executeDynamicBrake();
      break;

    case STATE_COAST:
      targetFL = targetFR = targetRL = targetRR = 0;
      // Soft-ramp to stop before releasing bridge to high impedance
      applySlewLimiter(currentFL, targetFL);
      applySlewLimiter(currentFR, targetFR);
      applySlewLimiter(currentRL, targetRL);
      applySlewLimiter(currentRR, targetRR);

      writeBridgeChannel(CH_FL_FWD, CH_FL_REV, currentFL);
      writeBridgeChannel(CH_FR_FWD, CH_FR_REV, currentFR);
      writeBridgeChannel(CH_RL_FWD, CH_RL_REV, currentRL);
      writeBridgeChannel(CH_RR_FWD, CH_RR_REV, currentRR);
      break;

    case STATE_DRIVE: {
      // Calculate normalized command vectors [-1.0, 1.0]
      float throttleCmd = (inputThrottle / 100.0f);
      if (gear == 'R') throttleCmd = -throttleCmd;

      float steerCmd = (inputSteer / 100.0f);
      int maxPwm = (int)((powerLimit / 100.0f) * 255.0f);

      int leftTrackPwm = 0;
      int rightTrackPwm = 0;
      computeDifferentialKinematics(throttleCmd, steerCmd, maxPwm, leftTrackPwm, rightTrackPwm);

      // Assign synchronized targets to front and rear wheels on each track
      targetFL = targetRL = leftTrackPwm;
      targetFR = targetRR = rightTrackPwm;

      // Filter outputs through slew limiter
      applySlewLimiter(currentFL, targetFL);
      applySlewLimiter(currentFR, targetFR);
      applySlewLimiter(currentRL, targetRL);
      applySlewLimiter(currentRR, targetRR);

      // Drive physical H-bridge drivers
      writeBridgeChannel(CH_FL_FWD, CH_FL_REV, currentFL);
      writeBridgeChannel(CH_FR_FWD, CH_FR_REV, currentFR);
      writeBridgeChannel(CH_RL_FWD, CH_RL_REV, currentRL);
      writeBridgeChannel(CH_RR_FWD, CH_RR_REV, currentRR);
      break;
    }
  }
}

// ============================================================================
// 6. COMMUNICATION & PARSING
// ============================================================================
void webSocketEvent(uint8_t num, WStype_t type, uint8_t * payload, size_t length) {
  if (type == WStype_TEXT) {
    lastPacket = millis();
    String msg = (char*)payload;
    if (msg.startsWith("S:")) {
      msg = msg.substring(2);
      int c1 = msg.indexOf(',');
      int c2 = msg.indexOf(',', c1 + 1);
      int c3 = msg.indexOf(',', c2 + 1);
      int c4 = msg.indexOf(',', c3 + 1);
      int c5 = msg.indexOf(',', c4 + 1);

      if (c1 > 0 && c2 > 0 && c3 > 0 && c4 > 0) {
        inputThrottle = msg.substring(0, c1).toInt();
        inputBrake    = msg.substring(c1 + 1, c2).toInt();
        inputSteer    = msg.substring(c2 + 1, c3).toInt();
        gear          = msg.charAt(c3 + 1);
        if (c5 > 0) {
          powerLimit   = msg.substring(c4 + 1, c5).toInt();
          parkingBrake = msg.substring(c5 + 1).toInt();
        } else {
          powerLimit   = msg.substring(c4 + 1).toInt();
        }
      }
    }
  }
}

// ============================================================================
// 7. SETUP & MAIN EXECUTION LOOP
// ============================================================================
void setup() {
  Serial.begin(115200);
  pinMode(STATUS_LED, OUTPUT);

  const int channels[8] = {CH_FL_FWD, CH_FL_REV, CH_FR_FWD, CH_FR_REV, CH_RL_FWD, CH_RL_REV, CH_RR_FWD, CH_RR_REV};
  const int pins[8]     = {FL_IN1, FL_IN2, FR_IN3, FR_IN4, RL_IN1, RL_IN2, RR_IN3, RR_IN4};

  for (int i = 0; i < 8; i++) {
    ledcSetup(channels[i], PWM_FREQ, PWM_RES);
    ledcAttachPin(pins[i], channels[i]);
    ledcWrite(channels[i], 0); // Ensure all outputs initialize LOW
  }

  WiFi.softAP("ESP32-Rover", "");
  Serial.println("Wi-Fi Hotspot Started: ESP32-Rover");

  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", INDEX_HTML);
  });
  server.begin();

  webSocket.begin();
  webSocket.onEvent(webSocketEvent);
}

void loop() {
  server.handleClient();
  webSocket.loop();

  // Watchdog Fail-Safe: triggers dynamic clamp if Wi-Fi or client socket drops
  if (millis() - lastPacket > WATCHDOG_MS) {
    inputThrottle = 0;
    inputBrake = 100;
  }

  // Execute control loop at ~66 Hz (15ms tick period)
  updateMotorController();
  delay(15);
}
