      pedal.addEventListener('touchstart', handleTouch, { passive: false });
      pedal.addEventListener('touchmove', handleTouch, { passive: false });
      pedal.addEventListener('touchend', resetTouch);
      pedal.addEventListener('touchcancel', resetTouch);
