    function toggleExplicitView() {
      currentView = (currentView === 'mobile') ? 'desktop' : 'mobile';
      applyViewLayout();
    }

    window.addEventListener('resize', applyViewLayout);
    window.addEventListener('orientationchange', () => setTimeout(applyViewLayout, 100));
    applyViewLayout();

    // WebSocket init with safe fallback
    try {
      if (window.location.hostname) {
