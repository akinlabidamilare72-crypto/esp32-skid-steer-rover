// Helper to write duty cycle to H-Bridge channel pairs
void setChannel(int fwdCh, int revCh, int duty) {
  if (duty > 0) {
    ledcWrite(fwdCh, duty);
    ledcWrite(revCh, 0);
  } else if (duty < 0) {
    ledcWrite(fwdCh, 0);
    ledcWrite(revCh, abs(duty));
  } else {
    ledcWrite(fwdCh, 0);
    ledcWrite(revCh, 0);
  }
}

