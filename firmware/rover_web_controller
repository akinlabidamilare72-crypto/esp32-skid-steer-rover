// --- Motor Output Hardware Helper ---
void setMotorChannel(int fwdCh, int revCh, int duty) {
  if (duty > 0) {
    ledcWrite(fwdCh, duty);
    ledcWrite(revCh, 0);
  } else if (duty < 0) {
    ledcWrite(fwdCh, 0);
    ledcWrite(revCh, abs(duty));
  } else {
    ledcWrite(fwdCh, 0);
    ledcWrite(revCh, 0);
  }
}

// --- WebSocket Event Handler ---
void webSocketEvent(uint8_t num, WStype_t type, uint8_t * payload, size_t length) {
  if (type == WStype_TEXT) {
    lastPacket = millis();
    // Parse "S:throttle,brake,steer,gear,limiter"
    String msg = (char*)payload;
    if (msg.startsWith("S:")) {
      msg = msg.substring(2);
      int c1 = msg.indexOf(',');
      int c2 = msg.indexOf(',', c1 + 1);
      int c3 = msg.indexOf(',', c2 + 1);
      int c4 = msg.indexOf(',', c3 + 1);

      if (c1 > 0 && c2 > 0 && c3 > 0 && c4 > 0) {
        inputThrottle = msg.substring(0, c1).toInt();
        inputBrake    = msg.substring(c1 + 1, c2).toInt();
        inputSteer    = msg.substring(c2 + 1, c3).toInt();
        gear          = msg.charAt(c3 + 1);
        powerLimit    = msg.substring(c4 + 1).toInt();
      }
    }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(STATUS_LED, OUTPUT);

  // Set up 4 PWM channels on ESP32 LEDC
  ledcSetup(CH_IN1, PWM_FREQ, PWM_RES);
  ledcSetup(CH_IN2, PWM_FREQ, PWM_RES);
  ledcSetup(CH_IN3, PWM_FREQ, PWM_RES);
  ledcSetup(CH_IN4, PWM_FREQ, PWM_RES);

  ledcAttachPin(LEFT_IN1, CH_IN1);
  ledcAttachPin(LEFT_IN2, CH_IN2);
  ledcAttachPin(RIGHT_IN3, CH_IN3);
  ledcAttachPin(RIGHT_IN4, CH_IN4);

  // Broadcast private SoftAP Wi-Fi network
  WiFi.softAP("ESP32-Rover", "");
  Serial.println("Wi-Fi AP active. SSID: ESP32-Rover");
  Serial.print("Access URL: http://");
  Serial.println(WiFi.softAPIP());

  // Serve controller page
  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", INDEX_HTML);
  });
  server.begin();

  webSocket.begin();
  webSocket.onEvent(webSocketEvent);
}

void loop() {
  server.handleClient();
  webSocket.loop();

  // Watchdog: Halt vehicle if client connection drops
  if (millis() - lastPacket > WATCHDOG_MS) {
    inputThrottle = 0;
    inputBrake = 100;
  }

  // --- Drive & Differential Calculations ---
  if (inputBrake > 10) {
    // Proportional electrical braking
    targetSpeedLeft = 0;
    targetSpeedRight = 0;
  } else {
    // Scale throttle by selected Max Power limiter
    float basePwm = (inputThrottle / 100.0) * (powerLimit / 100.0) * 255.0;
    if (gear == 'R') basePwm = -basePwm;

    float steerNorm = inputSteer / 100.0; // -1.0 to +1.0

    if (abs(basePwm) < 10 && abs(inputSteer) > 15) {
      // Zero-Radius Spin from standstill
      float spinPwm = (powerLimit / 100.0) * 200.0;
      targetSpeedLeft  = steerNorm * spinPwm;
      targetSpeedRight = -steerNorm * spinPwm;
    } else {
      // Proportional Electronic Differential Curving
      if (steerNorm > 0) {
        // Turning Right: slow down right track
        targetSpeedLeft  = basePwm;
        targetSpeedRight = basePwm * (1.0 - (steerNorm * 0.75));
      } else {
        // Turning Left: slow down left track
        targetSpeedLeft  = basePwm * (1.0 - (abs(steerNorm) * 0.75));
        targetSpeedRight = basePwm;
      }
    }
  }

  // Soft-start Acceleration Ramping
  if (currentSpeedLeft < targetSpeedLeft) currentSpeedLeft = min(currentSpeedLeft + RAMP_STEP, targetSpeedLeft);
  else if (currentSpeedLeft > targetSpeedLeft) currentSpeedLeft = max(currentSpeedLeft - RAMP_STEP, targetSpeedLeft);

  if (currentSpeedRight < targetSpeedRight) currentSpeedRight = min(currentSpeedRight + RAMP_STEP, targetSpeedRight);
  else if (currentSpeedRight > targetSpeedRight) currentSpeedRight = max(currentSpeedRight - RAMP_STEP, targetSpeedRight);

  // Output to L298N channels
  setMotorChannel(CH_IN1, CH_IN2, currentSpeedLeft);
  setMotorChannel(CH_IN3, CH_IN4, currentSpeedRight);

  delay(15);
}
