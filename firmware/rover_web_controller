    const keys = {};
    window.addEventListener('keydown', (e) => {
      const k = e.key.toLowerCase();
      if (!keys[k]) {
        keys[k] = true;
        updateDesktopControls();
      }
    });
    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
      updateDesktopControls();
    });

    function updateDesktopControls() {
      document.getElementById('keyW').classList.toggle('pressed', !!keys['w']);
      document.getElementById('keyA').classList.toggle('pressed', !!keys['a']);
      document.getElementById('keyS').classList.toggle('pressed', !!keys['s']);
      document.getElementById('keyD').classList.toggle('pressed', !!keys['d']);

