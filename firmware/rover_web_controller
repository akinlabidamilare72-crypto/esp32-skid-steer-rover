      ['deskBtnReverse', 'mobBtnReverse'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('active', g === 'R');
      });
    }

    function setMode(m) {
      mode = m;
      document.getElementById('mobBtnWheel').classList.toggle('active', m === 'wheel');
      document.getElementById('mobBtnTilt').classList.toggle('active', m === 'tilt');

      const arena = document.getElementById('mobileArena');
      if (mode === 'tilt') {
        arena.className = 'mobile-arena mode-tilt';
        enableTilt();
      } else {
        arena.className = 'mobile-arena mode-wheel';
        disableTilt();
      }
    }

    // Dynamic Limiter with Keyboard/Focus Shielding
    const powerSlider = document.getElementById('powerSlider');
    const limitVal = document.getElementById('limitVal');

    powerSlider.addEventListener('input', (e) => {
      limiter = parseInt(e.target.value);
      limitVal.innerText = limiter + '%';
    });
    powerSlider.addEventListener('pointerup', () => powerSlider.blur());
    powerSlider.addEventListener('change', () => powerSlider.blur());
    powerSlider.addEventListener('keydown', (e) => {
      e.preventDefault();
      powerSlider.blur();
    });

    // Unified Pointer-based Pedal Handler
    function setupPedal(wrapperId, fillId, onValChange) {
      const wrapper = document.getElementById(wrapperId);
      const fill = document.getElementById(fillId);
      let activePointerId = null;

      function updateValue(e) {
        const rect = wrapper.getBoundingClientRect();
        let ratio = (rect.bottom - e.clientY) / rect.height;
        ratio = Math.max(0, Math.min(1, ratio));
        fill.style.height = (ratio * 100) + '%';
        onValChange(Math.round(ratio * 100));
      }

      wrapper.addEventListener('pointerdown', (e) => {
        activePointerId = e.pointerId;
        wrapper.setPointerCapture(e.pointerId);
        updateValue(e);
      });

      wrapper.addEventListener('pointermove', (e) => {
        if (e.pointerId === activePointerId) updateValue(e);
      });

      function release(e) {
        if (e.pointerId === activePointerId) {
          activePointerId = null;
          fill.style.height = '0%';
          onValChange(0);
        }
      }

      wrapper.addEventListener('pointerup', release);
      wrapper.addEventListener('pointercancel', release);
    }

    setupPedal('accelPedal', 'accelFill', v => throttle = v);
    setupPedal('brakePedal', 'brakeFill', v => brake = v);

    // Steering Wheel Drag (+/- 150 deg)
    const wheelContainer = document.getElementById('wheelContainer');
    const wheelGraphic = document.getElementById('wheelGraphic');
    let wheelPointerId = null;

    wheelContainer.addEventListener('pointerdown', (e) => {
      wheelPointerId = e.pointerId;
      wheelContainer.setPointerCapture(e.pointerId);
      calculateWheelAngle(e);
    });

    wheelContainer.addEventListener('pointermove', (e) => {
      if (e.pointerId === wheelPointerId) calculateWheelAngle(e);
    });

    function calculateWheelAngle(e) {
      const rect = wheelGraphic.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      const deltaX = e.clientX - centerX;
      const deltaY = e.clientY - centerY;
      let deg = Math.atan2(deltaY, deltaX) * (180 / Math.PI) + 90;
      if (deg > 180) deg -= 360;
      deg = Math.max(-150, Math.min(150, deg));
      wheelGraphic.style.transform = `rotate(${deg}deg)`;
      steer = Math.round((deg / 150) * 100);
    }

    function resetWheel(e) {
      if (e.pointerId === wheelPointerId) {
        wheelPointerId = null;
        wheelGraphic.style.transform = 'rotate(0deg)';
        steer = 0;
      }
    }
    wheelContainer.addEventListener('pointerup', resetWheel);
    wheelContainer.addEventListener('pointercancel', resetWheel);

    // Device Tilt Handler
    function handleOrientation(e) {
      if (mode !== 'tilt') return;
      let gamma = e.gamma;
      if (gamma === null) return;
      gamma = Math.max(-40, Math.min(40, gamma));
      steer = Math.round((gamma / 40) * 100);
    }

    function enableTilt() {
      if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
        DeviceOrientationEvent.requestPermission().then(state => {
          if (state === 'granted') window.addEventListener('deviceorientation', handleOrientation);
        }).catch(console.error);
      } else {
        window.addEventListener('deviceorientation', handleOrientation);
      }
    }

    function disableTilt() {
      window.removeEventListener('deviceorientation', handleOrientation);
      steer = 0;
    }

    // Desktop Keyboard Handler
    const activeActions = { forward: false, backward: false, left: false, right: false };

    function resolveKeyAction(e) {
      const k = e.key.toLowerCase();
      const code = e.code;

      if (k === 'w' || e.key === 'ArrowUp' || code === 'KeyW' || code === 'ArrowUp' || code === 'Numpad8') return 'forward';
      if (k === 's' || e.key === 'ArrowDown' || k === ' ' || code === 'KeyS' || code === 'ArrowDown' || code === 'Space' || code === 'Numpad2' || code === 'Numpad5') return 'backward';
      if (k === 'a' || e.key === 'ArrowLeft' || code === 'KeyA' || code === 'ArrowLeft' || code === 'Numpad4') return 'left';
      if (k === 'd' || e.key === 'ArrowRight' || code === 'KeyD' || code === 'ArrowRight' || code === 'Numpad6') return 'right';
      return null;
    }

    window.addEventListener('keydown', (e) => {
      if (['arrowup', 'arrowdown', 'arrowleft', 'arrowright', ' '].includes(e.key.toLowerCase())) {
        e.preventDefault();
      }
      const action = resolveKeyAction(e);
      if (action) {
        activeActions[action] = true;
        syncControls();
      }
    });

    window.addEventListener('keyup', (e) => {
      const action = resolveKeyAction(e);
      if (action) {
        activeActions[action] = false;
        syncControls();
      }
    });

    function syncControls() {
      document.getElementById('keyW').classList.toggle('pressed', activeActions.forward);
      document.getElementById('keyA').classList.toggle('pressed', activeActions.left);
      document.getElementById('keyS').classList.toggle('pressed', activeActions.backward);
      document.getElementById('keyD').classList.toggle('pressed', activeActions.right);

      throttle = activeActions.forward ? 100 : 0;
      brake = activeActions.backward ? 100 : 0;

      if (activeActions.left && !activeActions.right) steer = -100;
      else if (activeActions.right && !activeActions.left) steer = 100;
      else steer = 0;
    }
  </script>
