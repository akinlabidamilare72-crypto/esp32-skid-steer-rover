void applyDynamicBrake() {
  const int channels[8] = {
    CH_FL_FWD, CH_FL_REV, CH_FR_FWD, CH_FR_REV, 
    CH_RL_FWD, CH_RL_REV, CH_RR_FWD, CH_RR_REV
  };
  for (int i = 0; i < 8; i++) {
    ledcWrite(channels[i], 255);
  }
}

// WebSocket Packet Parser: "S:throttle,brake,steer,gear,limiter,park"
void webSocketEvent(uint8_t num, WStype_t type, uint8_t * payload, size_t length) {
  if (type == WStype_TEXT) {
    lastPacket = millis();
    String msg = (char*)payload;
    if (msg.startsWith("S:")) {
      msg = msg.substring(2);
      int c1 = msg.indexOf(',');
      int c2 = msg.indexOf(',', c1 + 1);
      int c3 = msg.indexOf(',', c2 + 1);
      int c4 = msg.indexOf(',', c3 + 1);
      int c5 = msg.indexOf(',', c4 + 1);

      if (c1 > 0 && c2 > 0 && c3 > 0 && c4 > 0) {
        inputThrottle = msg.substring(0, c1).toInt();
        inputBrake    = msg.substring(c1 + 1, c2).toInt();
        inputSteer    = msg.substring(c2 + 1, c3).toInt();
        gear          = msg.charAt(c3 + 1);
        if (c5 > 0) {
          powerLimit   = msg.substring(c4 + 1, c5).toInt();
          parkingBrake = msg.substring(c5 + 1).toInt();
        } else {
          powerLimit   = msg.substring(c4 + 1).toInt();
        }
      }
    }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(STATUS_LED, OUTPUT);

  const int channels[8] = {CH_FL_FWD, CH_FL_REV, CH_FR_FWD, CH_FR_REV, CH_RL_FWD, CH_RL_REV, CH_RR_FWD, CH_RR_REV};
  const int pins[8]     = {FL_IN1, FL_IN2, FR_IN3, FR_IN4, RL_IN1, RL_IN2, RR_IN3, RR_IN4};

  for (int i = 0; i < 8; i++) {
    ledcSetup(channels[i], PWM_FREQ, PWM_RES);
    ledcAttachPin(pins[i], channels[i]);
  }

  WiFi.softAP("ESP32-Rover", "");
  Serial.println("Wi-Fi Hotspot Started: ESP32-Rover");

  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", INDEX_HTML);
  });
  server.begin();

  webSocket.begin();
  webSocket.onEvent(webSocketEvent);
}

void loop() {
  server.handleClient();
  webSocket.loop();

  // Watchdog Fail-Safe
  if (millis() - lastPacket > WATCHDOG_MS) {
    inputThrottle = 0;
    inputBrake = 100;
  }

  // ==========================================
  // DYNAMIC BRAKING & TORQUE VECTORING
  // ==========================================
  // Both normal brake pedal (>10%) and parking brake (==1) trigger dynamic clamp
  if (parkingBrake == 1 || inputBrake > 10) {
    targetFL = targetFR = targetRL = targetRR = 0;
    currentFL = currentFR = currentRL = currentRR = 0;
    applyDynamicBrake();
  } else {
    // Normal Drive Calculations
    float basePwm = (inputThrottle / 100.0) * (powerLimit / 100.0) * 255.0;
    if (gear == 'R') basePwm = -basePwm;

    float s = inputSteer / 100.0;

    if (abs(basePwm) < 10 && abs(inputSteer) > 15) {
      // Standstill Zero-Radius Spin
      float spinPwm = (powerLimit / 100.0) * 200.0;
      targetFL = targetRL = s * spinPwm;
      targetFR = targetRR = -s * spinPwm;
    } else {
      // Proportional 4-Corner Differential
      if (s > 0) {
        targetFL = basePwm;
        targetRL = basePwm * (1.0 - (s * 0.15));
        targetFR = basePwm * (1.0 - (s * 0.70));
        targetRR = basePwm * (1.0 - (s * 0.85));
      } else if (s < 0) {
        float absS = abs(s);
        targetFR = basePwm;
        targetRR = basePwm * (1.0 - (absS * 0.15));
        targetFL = basePwm * (1.0 - (absS * 0.70));
        targetRL = basePwm * (1.0 - (absS * 0.85));
      } else {
        targetFL = targetFR = targetRL = targetRR = basePwm;
      }
    }

    // Soft-start Acceleration Ramping
    auto ramp = [](int &current, int target) {
      if (current < target) current = min(current + RAMP_STEP, target);
      else if (current > target) current = max(current - RAMP_STEP, target);
    };

    ramp(currentFL, targetFL);
    ramp(currentFR, targetFR);
    ramp(currentRL, targetRL);
    ramp(currentRR, targetRR);

    // Output to Driver 1 (Front Axle)
    setChannel(CH_FL_FWD, CH_FL_REV, currentFL);
    setChannel(CH_FR_FWD, CH_FR_REV, currentFR);

    // Output to Driver 2 (Rear Axle)
    setChannel(CH_RL_FWD, CH_RL_REV, currentRL);
    setChannel(CH_RR_FWD, CH_RR_REV, currentRR);
  }

  delay(15);
}
