      console.warn("WebSocket offline fallback:", err);
    }

    setInterval(() => {
      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(`S:${throttle},${brake},${steer},${gear},${limiter}`);
      }
    }, 40);

    function setGear(g) {
      gear = g;
      ['deskBtnDrive', 'mobBtnDrive'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('active', g === 'D');
